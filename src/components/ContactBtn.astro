---
const email = "rose16.sananikone@gmail.com";
const phone = "+32 498 31 31 31";
---

<div class="contact-button-wrapper"><button class="contact-button" popovertarget="contact-popup">Contact me!</button></div>

<div id="contact-popup" class="contact-popup" popover aria-labelledby="contact-heading">
  <h2 id="contact-heading">Let's talk!</h2>
  <p>Send me an email and I'll get back to you.</p>
  <ul class="contact-list">
    <li><a href={`mailto:${email}`}>{email}</a></li>
    <li><a href={`tel:${phone.replaceAll(" ", "")}`}>{phone}</a></li>
  </ul>
</div>


<style>

  .contact-button-wrapper {
    text-align: center;
  }

    .contact-button {
    position: relative;
    isolation: isolate;
    padding: 0.9rem 2.5rem;
    border-radius: 999px;
    background-color: var(--color-accent);
    color: var(--color-bg);
    font-weight: 500;
    text-decoration: none;
    border: none;
    font-family: Jost;
    width: 80%;
    font-size: var(--fs-0);
  }

  .contact-button::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-color: var(--color-accent);
    filter: blur(6px);
    transform: translate(0.75rem, -0.25rem);
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .contact-button:hover::before,
  .contact-button:focus-visible::before {
    transform: none;
    filter: blur(0);
  }

  ul {
    list-style-type: none;
    padding: 0;
  }

  .contact-popup {
  border: none;
  color: var(--color-text);
  position: fixed;
  z-index: 10;
  height: 100dvh;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding: 1rem;
  background-color: var(--color-bg);
  border: 1.5px solid var(--color-accent);
  box-shadow:  0 0 3.4em gray;
  transform: translateY(100%);
  transition:
    transform 0.35s ease,
    visibility 0.35s,
    overlay 0.35s allow-discrete;
}

.contact-popup a {
  display: block;
  text-decoration: none;
  font-family: var(--font-display);
  font-size: 1.4rem;
  text-transform: uppercase;
  color: var(--color-text);
}

.contact-popup a[aria-current="page"],
.contact-popup a:hover,
.contact-popup a:focus {
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.2em;
  color: var(--color-accent);
}

.contact-popup:popover-open {
  transform: translateY(50%);
  visibility: visible;
}

@media screen and (width >= 39.75rem) {
  .contact-button {
    width: auto;
  }

  .contact-popup {
    inset: 10rem auto 1rem 1rem;
  }
}

@media (39.75rem <= width < 62.5rem) {
  .contact-button-wrapper {
  padding-left: clamp(0rem, 54.945rem - 87.912vw, 20rem);
  }
}

</style>
