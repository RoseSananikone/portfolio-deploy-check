---
import { Image } from "astro:assets";
import rose from "../content/img/rose.avif"
import Skills from '../components/Skills.astro'

const popups = [
  {
    id: "languages",
    title: "Trilingual",
    items: ["English", "French", "German"],
    text: "I have to switch language depending on who I am talking to pretty often and have experienced many different cultures from european, to middle eastern to asian cultures which all shape how I design for different people or ideas. Sharing experiences and exchanging different perspectives with people all over the world is my favourite. ",
  },
  {
    id: "hobbies",
    title: "Hobbies",
    items: ["Playing flute", "Playing video games and board games", "Hosting friends", "Cooking and baking"],
    text: "I usually try to combine my hobbies with my skills such as creating experiences people enjoy by inviting friends and curating the right foods, drinks and activities to do!",
  },
];
---

<section class="about">
  <div class="intro-text">
    <h2 class="intro-title">A Quick Intro!</h2>
    <p class="intro-subtitle">Get to know me and my skills :)</p>
  </div>
  <article class="about-me">
    <div class="about-photo">
<Image class="about-media" src={rose} format="avif" loading="eager" alt="lightly pixelated and blurry red open petal rose" width="1906" height="1997"
srcset="
/src/content/img/rose-256.avif 256w,
/src/content/img/rose-640.avif 640w,
/src/content/img/rose-792.avif 792w,
/src/content/img/rose-1060.avif 1060w,
/src/content/img/rose-1280.avif 1280w,
/src/content/img/rose-1520.avif 1520w,
/src/content/img/rose-1730.avif 1730w,
/src/content/img/rose-1920.avif 1920w"
sizes="(min-width: 820px) 640px, (min-width: 640px) 80vw, calc(100vw - 96px)"/>

{popups.map((popup) => (
  <button class={`float-button float-${popup.id}`} popovertarget={`${popup.id}-popup`}>
    {popup.title}
  </button>
))}
    </div>
    <div class="about-short-introduction">
      <p>I'm Rose Sananikone, a digital design and development student in the DEVINE program in Howest. I'm always eager and excited to explore more and push the limits of my skills to further develop them and combining them with my hobbies and other experiences.</p>
      <p class="about-instruction">Click the floating buttons to see more!</p>
    </div>
  </article>


  {popups.map((popup) => (
    <div id={`${popup.id}-popup`} class="popup" popover>
    <button class="popup-close" popovertarget={`${popup.id}-popup`} popovertargetaction="hide">Close</button>
    <h2>{popup.title}</h2>
    <ul>
      {popup.items.map((item) => <li>{item}</li>)}
    </ul>
    <p>{popup.text}</p>
  </div>
))}

</section>
<Skills />

<style>

  .intro-text {
  display: flex;
  flex-direction: column;
  align-items: center;
 }

  h2 {
  margin-bottom: 0;
  }

  .intro-subtitle {
    margin-top: 0;
  }

 .about-me {
  display: grid;
  justify-items: center;
  align-items: center;
  padding: 2rem;
 }

 .about-short-introduction {
  text-align: center;
  display: flex;
  flex-direction: column;
 }

 .about-instruction {
  font-size: var(--fs--2);
 }

  /* the buttons are positioned relative to this wrapper */
  .about-photo {
    position: relative;
    width: min(100%, 40rem);
    flex-shrink: 0;
  }

 .about-media {
  aspect-ratio: 1 / 1;
  object-fit: cover;
 }

  /* no border, just a shadow so they look like they float above the photo */
  .float-button {
    position: absolute;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 999px;
    background-color: var(--color-bg);
    box-shadow: 0 0.75rem 2rem rgb(27 23 22 / 0.18);
    font-family: var(--font-display);
    font-size: var(--fs-1);
    text-transform: uppercase;
    color: var(--color-text);
    cursor: pointer;
    transition: color 0.3s ease, scale 0.3s ease;
  }

  .float-button:hover,
  .float-button:focus-visible {
    color: var(--color-accent);
    scale: 1.05;
  }

    .float-hobbies {
    top: 70%;
    left: 1rem;
  }

  .float-languages {
    bottom: 12%;
    right: 1rem;
  }

  /* slow floating */
  @media (prefers-reduced-motion: no-preference) {
    .float-button {
      animation: float 4s ease-in-out infinite;
    }

    .float-languages {
      animation-delay: -2s;
    }
  }

  @keyframes float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -0.5rem; }
  }


  /* card that slides up from below when it opens */
  .popup {
    width: min(90vw, 60rem);
    max-height: 85dvh;
    overflow-y: auto;
    padding: 2rem;
    border: none;
    border-radius: 1rem;
    background-color: var(--color-bg);
    color: var(--color-text);
    box-shadow: 0 1.5rem 4rem rgb(27 23 22 / 0.25);
    opacity: 0;
    transform: translateY(3rem);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease,
      overlay 0.4s allow-discrete,
      display 0.4s allow-discrete;
  }

  .popup:popover-open {
    opacity: 1;
    transform: translateY(0);
  }

  /* where the card starts from when it opens */
  @starting-style {
    .popup:popover-open {
      opacity: 0;
      transform: translateY(3rem);
    }
  }

  .popup::backdrop {
    background-color: rgb(27 23 22 / 0);
    transition:
      background-color 0.4s ease,
      overlay 0.4s allow-discrete,
      display 0.4s allow-discrete;
  }

  .popup:popover-open::backdrop {
    background-color: rgb(27 23 22 / 0.5);
  }

  @starting-style {
    .popup:popover-open::backdrop {
      background-color: rgb(27 23 22 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .popup,
    .popup:popover-open {
      transform: none;
    }
  }

  .popup-close {
    float: right;
    background: none;
    border: none;
    font-family: var(--font-display);
    font-size: var(--fs-0);
    text-transform: uppercase;
    color: var(--color-text);
    cursor: pointer;
  }

  .popup-close:hover,
  .popup-close:focus-visible {
    color: var(--color-accent);
  }

  @media screen and ( width >= 68.125rem) {
    .about-me {
      display: flex;
      gap: 5rem;
    }
    .about-short-introduction{
      text-align: start;
    }
  }

</style>

