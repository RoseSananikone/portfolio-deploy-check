---
import { withBase } from "../utils/withBase.js";

---

  <section class="hero">
<h1 class="hero-title" data-text="Rose Sananikone">
  <span class="sharp">Rose Sananikone</span>
</h1>

    <div class="hero-text">
      <p class="hero-tagline">Life happens wherever you are, whether you make it or not.</p>
      <p class="hero-intro">
        A young creative designer who wants to experiment and try out new things with clear intentions and unique character.
      </p>
      <p class="hero-note">Based in Belgium  · open to work</p>
    </div>

    <a class="hero-button" href={withBase("/work/")}>View work</a>
  </section>

<style>

  :root {
  --fs-display-stacked: clamp(3.5rem, 1.5rem + 13vw, 4rem);
  --fs-display-inline: clamp(4rem, 1rem + 10vw, 12rem);
  --fs-tagline: clamp(1.25rem, 1.0054rem + 1.2228vw, 1.9531rem);
  }

  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
    padding-top: 4rem;
  }


  .hero-title {
  --band-top: 42%;
  --band-bottom: 68%;
    position: relative;
    width: min-content;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-display-stacked);
    line-height: 0.85;
    text-transform: uppercase;
    color: var(--color-text);
  }

  /* hide the sharp letters where the blur band sits */
.sharp {
  display: block;
  mask-image: linear-gradient(to bottom,
    #000 var(--band-top), transparent var(--band-top),
    transparent var(--band-bottom), #000 var(--band-bottom));
  mask-size: 100% 1lh;               /* one mask per line… */
  mask-repeat: repeat-y;             /* …repeated down every line */
}

.hero-title::after {
  content: attr(data-text);
  content: attr(data-text) / "";     /* screen readers skip the copy */
  position: absolute;
  inset: 0 -1rem;                    /* wider box so the blur isn't cut off at the sides… */
  padding-inline: 1rem;              /* …while the text inside wraps exactly like .sharp */
  opacity: 0.8;
  filter: blur(3px);
  mask-image: linear-gradient(to bottom,
    transparent var(--band-top), #000 var(--band-top),
    #000 var(--band-bottom), transparent var(--band-bottom));
  mask-size: 100% 1lh;
  mask-repeat: repeat-y;
  pointer-events: none;
}

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .hero-text p {
    margin: 0;
  }

  .hero-tagline {
    font-style: italic;
    font-weight: 300;
     font-size: var(--fs-tagline);
    line-height: 1.2;
    text-wrap: balance;
  }

  .hero-intro {
    max-width: 45ch;
    font-size: var(--fs--1);
    font-weight: 500;
  }

  .hero-note {
    font-size: var(--fs--1);
    color: var(--color-accent);
  }

  /* soft pill with a smudged double behind it */
  .hero-button {
    position: relative;
    isolation: isolate;
    padding: 0.9rem 2.5rem;
    border-radius: 999px;
    background-color: var(--color-pill);
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
  }

  .hero-button::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-color: var(--color-pill);
    filter: blur(6px);
    transform: translate(0.75rem, -0.25rem);
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .hero-button:hover::before,
  .hero-button:focus-visible::before {
    transform: none;
    filter: blur(0);
  }

 @media (width >= 30rem) {
    /* one line on larger screens */
    .hero-title {
      width: auto;
      font-size: var(--fs-display-inline);
    }

    .hero-tagline {
      width: auto;
    }
  }
</style>
