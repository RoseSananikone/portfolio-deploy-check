---

---

  <section class="hero">
    <h1 class="hero-title">
      <span class="line" data-text="Rose"><span class="sharp">Rose</span></span>
      <span class="line" data-text="Sananikone"><span class="sharp">Sananikone</span></span>
    </h1>

    <div class="hero-text">
      <p class="hero-tagline">A creative designer searching for more</p>
      <p class="hero-intro">
        Placeholder: a sentence or two about who you are, what you make and
        what you're looking for next.
      </p>
      <p class="hero-note">Placeholder: location · open to work</p>
    </div>

    <a class="hero-button" href="/work/">View work</a>
  </section>

<style>


  :root {
  /* @link https://utopia.fyi/type/calculator?c=320,18,1.2,1240,20,1.25,6,2,&s=0.75|0.5|0.25,1.5|2|3|4|6,s-l&g=s,l,xl,12 */
  --fs--2: clamp(0.7813rem, 0.7747rem + 0.0326vw, 0.8rem);
  --fs--1: clamp(0.9375rem, 0.9158rem + 0.1087vw, 1rem);
  --fs-0: clamp(1.125rem, 1.0815rem + 0.2174vw, 1.25rem);
  --fs-1: clamp(1.35rem, 1.2761rem + 0.3696vw, 1.5625rem);
  --fs-2: clamp(1.62rem, 1.5041rem + 0.5793vw, 1.9531rem);
  --fs-3: clamp(1.944rem, 1.771rem + 0.8651vw, 2.4414rem);
  --fs-4: clamp(2.3328rem, 2.0827rem + 1.2504vw, 3.0518rem);
  --fs-5: clamp(2.7994rem, 2.4462rem + 1.7658vw, 3.8147rem);
  --fs-6: clamp(3.3592rem, 2.8691rem + 2.4507vw, 4.7684rem);
}

  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.5rem, 1.5rem + 13vw, 9rem);
    line-height: 0.85;
    text-transform: uppercase;
    color: var(--color-text);
  }

  /* each word is its own line on phone */
  .line {
    position: relative;
    display: block;
  }

  /* hide the sharp letters where the blur band sits */
  .sharp {
    display: block;
    mask-image: linear-gradient(to bottom, #000 42%, transparent 42%, transparent 68%, #000 68%);
  }

  /* blurred copy of the word, clipped to a horizontal band */
  .line::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: rgb(27 23 22 / 0.8);
    filter: blur(3px);
    clip-path: inset(42% -1rem 32% -1rem);
    pointer-events: none;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .hero-text p {
    margin: 0;
  }

  .hero-tagline {
    font-style: italic;
    font-weight: 300;
     font-size: clamp(1.15rem, 1rem + 1.5vw, 2rem);
    line-height: 1.2;
  }

  .hero-intro {
    max-width: 45ch;
    font-size: 18px;
    font-weight: 500;
  }

  .hero-note {
    font-size: 0.8rem;
    color: var(--color-accent);
  }

  /* soft pill with a smudged double behind it */
  .hero-button {
    position: relative;
    isolation: isolate;
    padding: 0.9rem 2.5rem;
    border-radius: 999px;
    background-color: var(--color-pill);
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
  }

  .hero-button::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-color: var(--color-pill);
    filter: blur(6px);
    transform: translate(0.75rem, -0.25rem);
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .hero-button:hover::before,
  .hero-button:focus-visible::before {
    transform: none;
    filter: blur(0);
  }

 @media (width >= 39.75rem) {
    .hero-title {
      font-size: clamp(4rem, 1rem + 10vw, 12rem);
    }

    /* one line on larger screens */
    .line {
      display: inline-block;
    }
  }
</style>
