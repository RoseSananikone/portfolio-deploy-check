---
import { getCollection } from "astro:content";
import WorkCard from "./WorkCard.astro";

const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="work" aria-labelledby="work-heading">
  <header class="work-header">
    <h2 id="work-heading">My work</h2>
  </header>

  <ul class="project-list" role="list">
    {projects.map((project, index) => (
      <li>
        <WorkCard project={project} index={index} />
      </li>
    ))}
  </ul>
</section>


<style>
  .work {
    padding: 4rem 0;
  }

  .work-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-text);
    padding-bottom: 0.75rem;
  }

  .work-header h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.75rem, 12vw, 6rem);
    line-height: 0.9;
    text-transform: uppercase;
  }

  /* phone: one column */
  .project-list {
    display: grid;
    gap: 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 636px) {
    .project-list {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 1.5rem;
    }
  }

  @media screen and (min-width: 1000px) {
    .project-list {
      grid-template-columns: repeat(3, 1fr);
    }

    /* stagger the middle card for a more editorial feel */
    .project-list li:nth-child(3n + 2) {
      margin-top: 4rem;
    }
  }
</style>
