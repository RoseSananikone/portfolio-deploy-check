---
import { getCollection } from "astro:content";
const categories = await getCollection("skills");
---

<section class="skills">
  <h2>My skills</h2>

  <div class="skills-grid">
    {categories.map((category, index) => (
      <article class="skill-card">
        <span class="skill-number">{String(index + 1).padStart(2, "0")}</span>

        <div class="skill-body">
          <h3 class="skill-title">{category.data.title}</h3>
          <p class="skill-description">{category.data.description}</p>
        </div>

        <div class="skill-group">
          <h4 class="skill-label">Skills</h4>
          <ul class="pills">
            {category.data.skills.map((skill) => <li class="pill">{skill}</li>)}
          </ul>
        </div>

        {category.data.tools.length > 0 && (
          <div class="skill-group">
            <h4 class="skill-label">Tools</h4>
            <ul class="pills">
              {category.data.tools.map((tool) => <li class="pill pill-outline">{tool}</li>)}
            </ul>
          </div>
        )}
      </article>
    ))}
  </div>
</section>
