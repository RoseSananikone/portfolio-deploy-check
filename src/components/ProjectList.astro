---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  heading: string;
  featuredOnly?: boolean;
  limit?: number;
}

const { heading, featuredOnly = false, limit } = Astro.props;

const projects = (await getCollection("projects", ({ data }) =>
  featuredOnly ? data.featured : true
))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, limit); // slice(0, undefined) returns everything
---

<section class="projects" aria-labelledby="projects-heading">
  <header class="projects-header">
    <h2 id="projects-heading">{heading}</h2>
  </header>

  <ol class="project-list" role="list">
    {projects.map((project, index) => (
      <li>
        <ProjectCard project={project} index={index} />
      </li>
    ))}
  </ol>
</section>


<style>
  .projects-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-text);
    padding-bottom: 0.75rem;
  }

  .projects-header h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-5);
    line-height: 0.9;
    text-transform: uppercase;
  }

  /* phone: one column */
  .project-list {
    display: grid;
    gap: 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 636px) {
    .project-list {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 1.5rem;
    }
  }

  @media screen and (min-width: 1000px) {
    .project-list {
      grid-template-columns: repeat(3, 1fr);
    }

    /* stagger the middle card for a more editorial feel */
    .project-list li:nth-child(3n + 2) {
      margin-top: 4rem;
    }
  }
</style>
