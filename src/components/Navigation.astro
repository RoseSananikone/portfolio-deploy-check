---
interface Props {
  inFooter?: boolean;
}

// <Navigation inFooter /> renders a plain row of links (no popover, no id),
// so only the header owns #main-menu.
const { inFooter = false } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/work/", label: "Work" },
  { href: "/blog/", label: "Blog" },
  // { href: "/contact/", label: "Contact" },
];

const isActive = (href:any) =>
  href === "/" ? path === "/" : path.startsWith(href);
---
{inFooter ? (
  <nav class="footer-nav" aria-label="Footer">
    {links.map((link) => (
      <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
) : (
  <div id="main-menu" class="nav-links" popover>
    <button class="menu-close" popovertarget="main-menu" popovertargetaction="hide">Close</button>
    {links.map((link) => (
      <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
        {link.label}
      </a>
    ))}
  </div>
)}

<style>
  .footer-nav {
    display: none;
  }

  .footer-nav a {
    font-family: var(--font-display);
    font-size: var(--fs-1);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text);
  }

  .footer-nav a[aria-current="page"],
  .footer-nav a:hover,
  .footer-nav a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    color: var(--color-accent);
  }

  /* same breakpoint where the header switches from drawer to row */
  @media (width >= 39.75rem) {
    .footer-nav {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem clamp(1.5rem, 6vw, 5rem);
    }
  }
</style>
