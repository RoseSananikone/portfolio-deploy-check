---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  tag?: string;
  year?: number;
  date?: Date;
  backHref: string;
  backLabel: string;
}

const { title, tag, year, date, backHref, backLabel } = Astro.props;
---

<BaseLayout pageTitle={title}>
  <article class="article">
    <a class="back-link" href={backHref}>← {backLabel}</a>

    <header class="article-header">
      <h1 class="article-title">{title}</h1>

    <div class="article-meta">
  <span class="article-tag">{tag}</span>
   <span class="article-year">{year}</span>
   <span class="article-date">{date?.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}</span>
</div>
    </header>


{Astro.slots.has("media") && (
  <div class="article-media">
    <slot name="media" />
  </div>
)}
    <div class="details">
      <slot />
    </div>

    <a class="back-link" href={backHref}>← {backLabel}</a>
  </article>
</BaseLayout>

<style>
  .article {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    max-width: 48rem;
    margin-inline: auto;
    padding-block: 2rem 4rem;
  }

  .article-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .article-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.75rem, 12vw, 6rem);
    line-height: 0.9;
    text-transform: uppercase;
  }

  .article-meta {
    display: flex;
    align-self: stretch;
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgb(27 23 22 / 0.15);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-tag {
    padding: 0.2rem 0.8rem;
    border-radius: 999px;
    background-color: var(--color-pill);
    font-weight: 500;
  }

  .article-year {
    margin-left: auto;
    opacity: 0.6;
  }

  .article-media {
    overflow: hidden;
    border-radius: 1rem;
  }

</style>
