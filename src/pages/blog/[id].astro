---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import MarkdownLayout from "../../layouts/MarkdownLayout.astro";


export async function getStaticPaths() {
  const blogPosts = await getCollection("blogPosts");
  return blogPosts.map((blogPost:any) => ({
    params: { id: blogPost.id },
    props: { blogPost },
  }));
}

const { blogPost } = Astro.props;
const { title, category, date } = blogPost.data;
const { Content } = await render(blogPost);
---

<MarkdownLayout title={title} tag={category} date={date} backHref="/blog/" backLabel="All posts">
  <Content />
</MarkdownLayout>
